BOT_TOKEN=your_bot_token_here

POSTGRES_DB=linkgen
POSTGRES_USER=linkgen
POSTGRES_PASSWORD=strongpassword
DATABASE_URL=postgresql+asyncpg://linkgen:strongpassword@postgres:5432/linkgen

REDIS_URL=redis://redis:6379

STATIC_DIR=/app/static
TEMPLATES_DIR=/app/templates

# Domain used for preview links (must have wildcard DNS + SSL)
PREVIEW_DOMAIN=preview.domain1.com

# Суперадмины — могут управлять доступом через админ панель (через запятую)
# Все ID из этого списка автоматически имеют полный доступ к боту
SUPER_ADMIN_IDS=123456789,987654321

# Telegram IDs администраторов для веб-чата (через запятую)
# Если SUPER_ADMIN_IDS не задан, используется как запасной вариант
ADMIN_IDS=123456789

# ID приватного канала/группы для получения уведомлений о заявках (например: -1001234567890)
NOTIFY_CHAT_ID=-1001234567890

# ── Автоматическое добавление доменов ─────────────────────────────────────────

# Cloudflare API токен (Zone:Read + DNS:Read прав достаточно для проверки DNS)
CF_API_TOKEN=your_cloudflare_api_token

# IP адрес VPS — проверяется в DNS записях @ и *
VPS_IP=1.2.3.4

# Email для Let's Encrypt сертификатов
CERTBOT_EMAIL=admin@example.com

# Путь к credentials.ini для certbot-dns-cloudflare (на хосте)
CF_CREDENTIALS=/root/.cloudflare/credentials.ini

# Директория для nginx конфигов доменов (должна существовать на хосте)
NGINX_DOMAINS_DIR=/etc/nginx/conf.d/domains

# Имя проекта docker-compose (используется для docker exec nginx)
COMPOSE_PROJECT_NAME=linkspanel
